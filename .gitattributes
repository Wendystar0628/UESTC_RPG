* text=auto eol=lf
# cmd 按系统代码页逐行解析，中文 rem 行只有在 CRLF 下才不会被拆成命令
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.glb binary
*.res binary
*.pck binary
*.otf binary
*.ttf binary
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
