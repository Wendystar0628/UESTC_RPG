# Godot
.godot/

# .NET
bin/
obj/
.vs/
*.user

# Python（工程脚本与离线音频工具的虚拟环境）
.venv/
__pycache__/

# 本地产物：截图、门禁输出
output/

# 构建时生成的代码指纹
/game/data/build-code-fingerprints.json

# 构建时生成的着色器 include 与本地资源 UID
/game/style/shaders/style_consts.gdshaderinc
/game/style/shaders/style_consts.gdshaderinc.uid
/game/style/outline/fog.glslinc
/game/style/outline/fog.glslinc.uid

# 生产烘焙暂存与管线摘要
/game/bake/

# gdUnit4 runtime adapter injects its own temporary SceneTree runner.
/game/gdunit4_testadapter_v*/

# CSV 翻译导入时由引擎生成
*.translation

# 作者观察台的本地数据（采集脚本与发布工具生成）
/dashboard/data/
