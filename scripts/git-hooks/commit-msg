#!/bin/sh
# 提交首行格式检查（STD-CONVENTIONS §3.8，D-251）：不合格式就拒绝提交，改好再提交。
# 用法：复制到 .git/hooks/commit-msg（工作树共用这一份；不改 core.hooksPath，免得停掉 Git LFS 的钩子），之后每次 git commit 自动跑。
first=$(head -n 1 "$1")
if printf '%s\n' "$first" | LC_ALL=C.UTF-8 grep -qE '^([QCS]-[0-9]{3}[a-z]?(/[QCS]-[0-9]{3}[a-z]?)* |(文档|工具|数据)(：|:)|Merge |Revert |fixup! |squash! )'; then
  exit 0
fi
echo "提交首行不合 STD-CONVENTIONS §3.8：写 \`<队列行号> <领域词>：一句话\`（如 \`Q-034a 街道家具：主路口横排白色石球\`），没有行号的用 \`文档：\`、\`工具：\`、\`数据：\` 开头。" >&2
echo "这次的首行：$first" >&2
exit 1
