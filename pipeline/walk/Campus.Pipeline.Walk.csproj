<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>Campus.Pipeline.Walk</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../game/contracts/Campus.Contracts.csproj;../../game/gen/**/*.csproj;../map/Campus.Pipeline.Map.csproj" />
  </ItemGroup>
  <Target Name="GenerateBuildInformation" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/build/build-info.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)/../..&quot; -Output &quot;$(IntermediateOutputPath)BuildInfo.g.cs&quot; -Configuration &quot;$(Configuration)&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" /></ItemGroup>
  </Target>
</Project>
