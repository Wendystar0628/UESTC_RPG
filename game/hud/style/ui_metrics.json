{
  "_doc": "界面的非色令牌：主题切换、着色器色表顺序、尺寸、字号、形状、线宽、影与辉光的几何、动效曲线与时长（UI-VISUAL）。按 UI-VISUAL 由 UiTokens 读取；色值只在 game/style/palette/ext/ui.json。单位是 1920×1080 基准的逻辑像素（随界面缩放），标 Phys 的是物理像素，时长 ms，弹簧 response 秒。以 _ 开头的键是注释，读取方忽略。",
  "format": 1,

  "themeSwitch": {
    "_ref": "UI-VISUAL",
    "signal": "sun.altDeg",
    "toDarkBelowDeg": -0.5,
    "toLightAboveDeg": 0.5,
    "sweepMs": 600,
    "frontWidth": 0.02,
    "frontDelta": 0.16,
    "sunsetDirection": "leftToRight",
    "sunriseDirection": "rightToLeft",
    "judgeAfterFastForward": true,
    "settings": { "theme": ["auto", "light", "dark"], "themeDefault": "auto", "resident": ["dark", "follow"], "residentDefault": "dark" },
    "pinnedDark": ["minimap", "timeCard", "timeStrip", "toast", "arrivalRecommend", "speedLeds", "viewMode", "weatherStrip", "hudIconButtons"],
    "followTheme": ["atlas", "settingsCard", "savePage", "dialog", "credits"],
    "noTheme": ["titlePage", "cinema", "overTitle"]
  },

  "shader": {
    "_ref": "UI-VISUAL：ui_panel 的色表 pal_day / pal_night 按这个顺序由 ui.json 的 themes.light / themes.dark 写入，下标即着色器里的 R_* 常量；只在末尾追加",
    "panelRoles": [
      "surface.panel", "surface.solid", "surface.raised", "surface.sunk",
      "surface.selected", "surface.frost", "surface.hover", "surface.row.hover",
      "text.1", "text.2", "text.off", "text.accent",
      "line.hair", "line.panel", "line.control", "line.highlight",
      "line.card.hover", "primary.fill", "primary.hover", "primary.press",
      "primary.ink", "primary.line", "graphic", "led.on",
      "led.halo", "glow", "now", "now.outline",
      "scrim", "shadow.ambient", "shadow.float", "shadow.float.near",
      "iris.a", "iris.b", "focus.backing", "trace",
      "tooltip.fill", "tooltip.text", "success.text", "success.fill",
      "warning.text", "warning.fill", "danger.text", "danger.fill",
      "danger.ink", "info.text", "info.fill", "moon.fill",
      "moon.shade", "over.title.band", "over.title.text", "over.title.shadow",
      "line.scroll"
    ],
    "screenFront": "trace"
  },

  "metrics": {
    "base": { "width": 1920, "height": 1080, "centralFree": [384, 216, 1536, 864] },
    "grid": { "unit": 8, "half": 4 },
    "space": {
      "scale": [4, 8, 12, 16, 20, 24, 32, 48, 64],
      "screenEdge": 32,
      "panelPad": 16,
      "panelPadWide": 20,
      "pagePad": 24,
      "control": 8,
      "group": 16,
      "kerf": [8, 16],
      "hotCorner": 64
    },
    "size": {
      "keycap": 24,
      "tag": 24,
      "compact": 32,
      "segment": 36,
      "dropdown": 36,
      "dropdownRow": 34,
      "tab": 38,
      "secondary": 40,
      "iconButton": 40,
      "iconButtonCompact": [32, 36],
      "primary": 44,
      "settingsRow": 40,
      "listRow": 44,
      "listRowThumb": 64,
      "thumb": [96, 54],
      "toast": 40,
      "toastBottom": 150,
      "switch": [40, 20],
      "switchKnob": [14, 14],
      "fader": [12, 20],
      "checkbox": 18,
      "scrollbar": [4, 6],
      "primaryMinWidth": 152,
      "primaryPadX": 20,
      "secondaryMinWidth": 132,
      "dropdownMinWidth": 190,
      "dialogWidth": 520,
      "tooltipMaxWidth": 340,
      "tooltipPad": [8, 12],
      "tooltipOffset": 12,
      "tabGap": 22,
      "icon": 24,
      "iconInButton": 20,
      "timeCard": [344, 470],
      "timeStrip": [290, 56],
      "weatherStrip": [440, 52],
      "weatherCell": 36,
      "speedBar": [392, 64],
      "speedLed": [7, 14],
      "settingsCard": [620, 1016],
      "minimap": [244, 272],
      "hudIconButton": 40,
      "memoryCard": [400, 212],
      "toastWidthMax": 520
    },
    "type": {
      "_ref": "UI-VISUAL；size 逻辑像素 / lineHeight 倍数 / tracking em",
      "families": {
        "zh": { "name": "Source Han Sans SC", "files": { "Light": "SourceHanSansSC-Light.otf", "Regular": "SourceHanSansSC-Regular.otf", "Medium": "SourceHanSansSC-Medium.otf" }, "license": "OFL-1.1" },
        "latin": { "name": "Inter", "files": { "Light": "Inter-Light.ttf", "Regular": "Inter-Regular.ttf", "Medium": "Inter-Medium.ttf" }, "license": "OFL-1.1" },
        "mono": { "name": "JetBrains Mono", "files": { "Regular": "JetBrainsMono-Regular.ttf", "Medium": "JetBrainsMono-Medium.ttf" }, "license": "OFL-1.1" }
      },
      "chains": { "body": ["latin", "zh"], "data": ["mono", "zh"], "title": ["zh", "latin"] },
      "allowSystemFallback": false,
      "tabularFigures": "tnum",
      "cjkLatinGap": "U+2005",
      "minZh": 14,
      "minMonoCaps": 12,
      "defaultSize": 16,
      "roles": {
        "display-1": { "chain": "title", "weight": "Light", "size": 96, "lineHeight": 1.15, "tracking": 0.30, "msdf": true },
        "display-2": { "chain": "title", "weight": "Light", "size": 72, "lineHeight": 1.15, "tracking": 0.40, "msdf": true },
        "h1": { "chain": "title", "weight": "Light", "size": 40, "lineHeight": 1.2, "tracking": 0.24, "msdf": true },
        "readout": { "chain": "body", "weight": "Light", "size": 42, "lineHeight": 1.0, "tracking": 0, "tnum": true },
        "readout.strip": { "chain": "body", "weight": "Light", "size": 26, "lineHeight": 1.0, "tracking": 0, "tnum": true },
        "map.title": { "chain": "title", "weight": "Light", "size": 30, "lineHeight": 1.2, "tracking": 0.20 },
        "h2": { "chain": "title", "weight": "Medium", "size": 24, "lineHeight": 1.3, "tracking": 0.06 },
        "h3": { "chain": "title", "weight": "Medium", "size": 18, "lineHeight": 1.4, "tracking": 0.04 },
        "button.primary": { "chain": "body", "weight": "Medium", "size": 17, "lineHeight": 1.2, "tracking": 0.06 },
        "body": { "chain": "body", "weight": "Regular", "size": 16, "lineHeight": 1.6, "tracking": 0.02 },
        "body.strong": { "chain": "body", "weight": "Medium", "size": 16, "lineHeight": 1.6, "tracking": 0.02 },
        "segment": { "chain": "body", "weight": "Regular", "size": 15, "lineHeight": 1.2, "tracking": 0 },
        "segment.on": { "chain": "body", "weight": "Medium", "size": 15, "lineHeight": 1.2, "tracking": 0 },
        "small": { "chain": "body", "weight": "Regular", "size": 14, "lineHeight": 1.5, "tracking": 0 },
        "data": { "chain": "data", "weight": "Regular", "size": 13, "lineHeight": 1.4, "tracking": 0 },
        "keycap": { "chain": "data", "weight": "Medium", "size": 13, "lineHeight": 1.0, "tracking": 0 },
        "tick": { "chain": "data", "weight": "Regular", "size": 12, "lineHeight": 1.0, "tracking": 0 },
        "mono-caps": { "chain": "data", "weight": "Medium", "size": 12, "lineHeight": 1.3, "tracking": 0.10, "upper": true, "maxWords": 4 },
        "subtitle": { "chain": "title", "weight": "Regular", "size": 26, "lineHeight": 1.5, "tracking": 0.06 }
      }
    },
    "shape": {
      "_ref": "UI-VISUAL：只切左上一个 45° 角",
      "chamfer": { "page": 14, "panel": 12, "card": 10, "primary": 8, "small": 0 },
      "chamferMinWidth": 48,
      "cornerMinor": 2,
      "radius": { "keycap": 3, "switch": 2, "tooltip": 2 },
      "expandMargin": 6,
      "signatureVia": 4
    },
    "line": {
      "_ref": "UI-VISUAL",
      "hairPhys": 1,
      "indicator": 2,
      "selectedIris": 1.5,
      "toastBar": 3,
      "keycapDepth": 2.5,
      "nowOutline": 1.5,
      "previewArc": 1.5,
      "previewArcGap": 6,
      "connectorPhys": 1,
      "connectorMap": 1.2,
      "tick": [1, 5],
      "tickLongEvery": 6,
      "dash": [4, 3],
      "iconStroke": 1.5
    },
    "via": { "core": 6, "halo": 2, "small": 4, "states": ["off", "on", "warn", "error"] },
    "focus": { "offset": 3, "corePhys": 1, "backingPhys": 1, "irisPhys": 0.7, "irisMax": 0.35, "tightenFrom": 2 },
    "glow": { "radius": 4, "max": 0.30, "maxCount": 3, "falloff": "exp", "maxRelLuminance": 0.78 },
    "shadow": {
      "_ref": "UI-VISUAL 的 shadow.* 的几何；颜色在 ui.json",
      "shadow.ambient": { "light": { "x": 0, "y": 2, "blur": 12 }, "dark": null },
      "shadow.float": { "light": { "x": 0, "y": 8, "blur": 24 }, "dark": { "x": 0, "y": 10, "blur": 30 } },
      "shadow.float.near": { "light": { "x": 0, "y": 1, "blur": 2 }, "dark": null }
    },
    "material": {
      "panelOpacity": { "light": 0.94, "dark": 0.90 },
      "frost": { "light": 0.84, "dark": 0.80, "lod": 3.5 },
      "reduceTransparencyOpacity": 1.0
    },
    "icon": { "grid": 24, "live": 20, "sizes": [16, 20, 24], "mapMarker": [20, 28], "miterLimit": 4, "innerRadius": 1, "solidMax": 0.25 },
    "map": {
      "_ref": "UI-VISUAL 令牌中的地图色表里的几何；颜色在 ui.json 的 map 段",
      "map.bound": { "dash": [5, 3] },
      "map.label.halo": { "width": 2 },
      "map.player": { "lineWidth": 1.5, "glow": { "light": 0, "dark": 4 } }
    }
  },

  "motion": {
    "_ref": "UI-VISUAL",
    "curves": {
      "Enter": [0.2, 0.7, 0.2, 1.0],
      "Exit": [0.3, 0.0, 0.8, 0.15],
      "Standard": [0.2, 0.0, 0.0, 1.0]
    },
    "springs": {
      "spatial": { "zeta": 1.0, "response": [0.2, 0.4], "default": 0.22 },
      "effect": { "zeta": 1.0, "response": [0.12, 0.2], "in": 0.15, "out": 0.2 },
      "zetaMin": 0.9
    },
    "step": { "global": "step_rate", "default": 12, "cap30": 15 },
    "bannedTransitions": ["Back", "Elastic", "Bounce", "Spring"],
    "durations": {
      "press": { "in": 0, "out": 120, "curve": "Standard", "shift": 1 },
      "hover": { "spring": "effect", "in": 0.15, "out": 0.2 },
      "focus": { "in": 0, "tighten": 160, "out": 0, "curve": "Enter", "shift": 2 },
      "select": { "spring": "spatial", "response": 0.22 },
      "selectLamp": 90,
      "tooltip": { "delay": 400, "in": 120, "out": 80, "curve": "Enter/Exit", "shift": 2 },
      "small": { "in": [200, 240], "out": [140, 160], "curve": "Enter/Exit", "shiftIn": 4, "shiftOut": 2 },
      "card": { "in": [240, 300], "out": [160, 200], "curve": "Enter/Exit", "shift": [4, 8] },
      "value": { "in": [180, 240], "curve": "Enter", "spring": 0.25 },
      "quantize": { "stepsIn": 4, "stepsOut": 2 },
      "page": { "in": [360, 450], "out": [220, 300], "curve": "Enter/Exit", "shift": 8 },
      "bigTransition": { "total": [600, 1200], "elementMax": 450 },
      "title": { "in": 900, "out": 600, "hold": 2400, "perGlyph": 50 },
      "dayNight": { "sweep": 600, "handleTurnDeg": 6 },
      "statusLamp": { "period": 2400, "min": 0.55, "endFade": 300 },
      "waitLamps": { "period": 1600, "allOff": 400, "showAfter": 1500, "showAfterColdBoot": 4000 },
      "trace": { "panel": 400, "route": [400, 600], "saved": 450, "connector": 240, "land": 120, "head": 8, "tail": 120 },
      "scan": { "atlas": 420, "frontPhys": 1, "fadeBand": 12 },
      "grid": { "wave": 450, "cell": 16, "alpha": 0.08, "steps": 4, "lastStart": 0.78 },
      "scrim": 220,
      "panelOpen": { "edge": [0, 180], "fill": [60, 200], "rows": [120, 320], "rowStagger": 30, "rowShift": 4 },
      "settingsPage": { "in": 260, "shift": 8, "groupStagger": 30 },
      "weatherStrip": { "in": 220, "cellStagger": 25 },
      "fastForward": { "sampleHz": 10, "handleSpring": 0.2 }
    },
    "stagger": { "step": [30, 40], "maxItems": 6, "maxExtra": 240, "exit": false },
    "limits": {
      "glowCount": 3,
      "glowRadius": 4,
      "glowMax": 0.30,
      "flashPerSecond": 1,
      "flashDelta": 0.10,
      "transitionMeanDelta": 0.10,
      "frontDeltaMax": 0.20,
      "irisMax": 0.35,
      "breathMaxHz": 0.5,
      "breathAmp": 0.45,
      "noBreathOverMs": 5000
    },
    "reduced": {
      "fadeMax": 200,
      "traceLand": 120,
      "scanFade": 200,
      "gridFade": 200,
      "quantizeFade": 150,
      "springFade": 100,
      "dayNight": "instant",
      "dayNightCue": 300,
      "worldVeil": 500
    }
  }
}
