{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cinematic-clouds.schema.json",
  "title": "Cinematic cloud layout format 1",
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "map": {
      "$ref": "#/$defs/mapId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shader": {
      "const": "res://style/shaders/cine_cloud.gdshader"
    },
    "camVeil": {
      "type": "object",
      "properties": {
        "offset": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "offset",
        "scale"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cloudLayer"
      }
    }
  },
  "required": [
    "format",
    "map",
    "name",
    "shader",
    "camVeil",
    "layers"
  ],
  "additionalProperties": false,
  "$comment": "Layer IDs must be unique; cloud-card basis vectors must be valid. These semantic checks accompany schema validation. No characters or persistent world-state fields are permitted.",
  "$defs": {
    "mapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "vector2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vector4": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "cloudCard": {
      "type": "object",
      "properties": {
        "p": {
          "$ref": "#/$defs/vector3"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "faceYaw": {
          "type": "number"
        },
        "axisX": {
          "$ref": "#/$defs/vector3"
        },
        "axisZ": {
          "$ref": "#/$defs/vector3"
        },
        "custom": {
          "$ref": "#/$defs/vector4"
        }
      },
      "required": [
        "p",
        "size",
        "faceYaw",
        "axisX",
        "axisZ",
        "custom"
      ],
      "additionalProperties": false
    },
    "cloudLayer": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cloudCard"
          }
        }
      },
      "required": [
        "layer",
        "cards"
      ],
      "additionalProperties": false
    }
  }
}
