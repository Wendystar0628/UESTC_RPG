{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityProfile v1",
  "description": "Serialized Campus.Contracts.Quality.QualityProfile in the graphics section of settings.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preset",
    "overrides"
  ],
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "balanced",
        "fine",
        "ultra",
        "custom"
      ]
    },
    "overrides": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "displayMode",
          "windowSize",
          "vSync",
          "frameCap",
          "renderScale",
          "antiAliasing",
          "shadowQuality",
          "shadowDistance",
          "foliageDensity",
          "reflectionInterval",
          "particleDensity"
        ]
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "schema": {
      "type": "integer",
      "const": 1,
      "default": 1
    }
  }
}
