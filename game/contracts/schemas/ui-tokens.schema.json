{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI color tokens (UI-VISUAL 3.8, 11.3)",
  "description": "The ui.json source for UI color ramps, special colors, theme references and map color tokens. No 3D palette entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ramps",
    "special",
    "themes",
    "map"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ramps": {
      "type": "object",
      "required": [
        "blue",
        "neutral",
        "success",
        "warning",
        "danger"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*$"
      },
      "properties": {
        "blue": {
          "allOf": [
            {
              "$ref": "#/$defs/ramp"
            }
          ],
          "required": [
            "50",
            "100",
            "200",
            "300",
            "400",
            "500",
            "600",
            "700",
            "800",
            "900",
            "950"
          ]
        },
        "neutral": {
          "allOf": [
            {
              "$ref": "#/$defs/ramp"
            }
          ],
          "required": [
            "0",
            "25",
            "50",
            "100",
            "150",
            "200",
            "300",
            "400",
            "500",
            "600",
            "700",
            "800",
            "850",
            "900",
            "950",
            "975"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ramp"
      }
    },
    "special": {
      "type": "object",
      "required": [
        "ink",
        "screen",
        "screen.solid",
        "screen.raised",
        "screen.sunk",
        "nighttext",
        "now"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/colorToken"
      }
    },
    "themes": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "$ref": "#/$defs/theme"
        },
        "dark": {
          "$ref": "#/$defs/theme"
        }
      },
      "description": "light and dark must have identical token key sets; checked by Campus.Contracts.UiPalette.Validate during G5."
    },
    "map": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "$ref": "#/$defs/mapTheme"
        },
        "dark": {
          "$ref": "#/$defs/mapTheme"
        }
      },
      "description": "light and dark must have identical token key sets; checked by Campus.Contracts.UiPalette.Validate during G5."
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^(?:ui\\.)?[a-z][a-z0-9]*(?:\\.[a-z0-9]+)*(?:@(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?))?$",
      "description": "Named color with optional alpha multiplier. The reserved name none means do not draw (fully transparent RGBA). Resolution order: special, ramps split at the first dot, then PaletteRegistry. Optional ui. prefix is accepted.",
      "examples": [
        "none",
        "neutral.25@0.94",
        "screen.solid",
        "danger.solid.light",
        "window.warm"
      ]
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "color": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "$ref": "#/$defs/hexColor"
        }
      ]
    },
    "ramp": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "colorToken": {
      "anyOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "scene": {
              "type": "boolean"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/colorToken"
          }
        }
      ]
    },
    "referenceToken": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/referenceToken"
          }
        }
      ]
    },
    "theme": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/reference"
      }
    },
    "mapTheme": {
      "type": "object",
      "required": [
        "map.base",
        "map.outskirts",
        "map.edge",
        "map.land",
        "map.green",
        "map.water",
        "map.plaza",
        "map.road",
        "map.sport",
        "map.building",
        "map.landmark",
        "map.bound",
        "map.interior",
        "map.label",
        "map.label.halo",
        "map.player"
      ],
      "propertyNames": {
        "pattern": "^map\\.[a-z][a-z0-9]*(?:\\.[a-z0-9]+)*$"
      },
      "properties": {
        "map.green": {
          "type": "object",
          "required": [
            "spring",
            "summer",
            "autumn",
            "winter",
            "scene"
          ],
          "properties": {
            "scene": {
              "const": true
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/referenceToken"
      }
    }
  }
}
