{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cinematic-extras.schema.json",
  "title": "Cinematic extras format 1",
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "map": {
      "$ref": "#/$defs/mapId"
    },
    "refs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/lampCue"
          },
          {
            "$ref": "#/$defs/birdFlock"
          }
        ]
      },
      "description": "Every key equals its contained ref. kind is the first serialized field as required by ContractJson polymorphism."
    }
  },
  "required": [
    "format",
    "map",
    "refs"
  ],
  "additionalProperties": false,
  "$defs": {
    "mapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "vector2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vector4": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "lampCue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "lampCue"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/vector2"
          }
        },
        "band": {
          "type": "number",
          "minimum": 0
        },
        "front": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "release": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "ref",
        "group",
        "route",
        "band",
        "front",
        "release"
      ],
      "additionalProperties": false,
      "description": "Route stores x,z metres. Front stores increasing timeline-second/route-distance pairs; release revokes the timing override. Validate ordered times and distances against route length semantically."
    },
    "birdFlock": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "birds"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 6,
          "maximum": 9
        },
        "start": {
          "$ref": "#/$defs/vector3"
        },
        "heading": {
          "type": "number"
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "climb": {
          "type": "number"
        },
        "spread": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "flapStep": {
          "enum": [
            "t12"
          ]
        },
        "fade": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "kind",
        "ref",
        "asset",
        "count",
        "start",
        "heading",
        "speed",
        "climb",
        "spread",
        "flapStep",
        "fade"
      ],
      "additionalProperties": false
    }
  }
}
