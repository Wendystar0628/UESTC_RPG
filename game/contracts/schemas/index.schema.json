{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "Map index v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "defaultMap": {
      "$ref": "#/$defs/mapId"
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/mapId"
          },
          "dir": {
            "type": "string",
            "pattern": "^res://.+/$"
          }
        },
        "required": [
          "id",
          "dir"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "defaultMap",
    "maps"
  ],
  "additionalProperties": false,
  "$defs": {
    "mapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "vector2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "name": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "yawDeg": {
          "type": "number"
        },
        "pitchDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fovDeg": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "position",
        "yawDeg",
        "pitchDeg"
      ],
      "additionalProperties": false
    },
    "stand": {
      "type": "object",
      "properties": {
        "feet": {
          "$ref": "#/$defs/vector3"
        },
        "yawDeg": {
          "type": "number"
        }
      },
      "required": [
        "feet",
        "yawDeg"
      ],
      "additionalProperties": false
    },
    "box3": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector3"
        },
        "max": {
          "$ref": "#/$defs/vector3"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector2"
        },
        "max": {
          "$ref": "#/$defs/vector2"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "worldPreset": {
      "type": "object",
      "properties": {
        "clock": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "season": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
        },
        "weather": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "clear",
                "fewClouds",
                "cloudy",
                "overcast",
                "fog",
                "lightRain",
                "rain",
                "thunderstorm",
                "afterRain",
                "snow",
                "afterSnow"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "intensity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clock",
        "season"
      ],
      "additionalProperties": false
    },
    "slotId": {
      "type": "string",
      "pattern": "^(s[1-3]|m[1-9])$"
    }
  }
}
