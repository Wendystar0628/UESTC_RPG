{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.schema.json",
  "title": "Atlas markers or labels v1",
  "oneOf": [
    {
      "$ref": "#/$defs/markersFile"
    },
    {
      "$ref": "#/$defs/labelsFile"
    }
  ],
  "$defs": {
    "mapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "vector2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "name": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "yawDeg": {
          "type": "number"
        },
        "pitchDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fovDeg": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "position",
        "yawDeg",
        "pitchDeg"
      ],
      "additionalProperties": false
    },
    "stand": {
      "type": "object",
      "properties": {
        "feet": {
          "$ref": "#/$defs/vector3"
        },
        "yawDeg": {
          "type": "number"
        }
      },
      "required": [
        "feet",
        "yawDeg"
      ],
      "additionalProperties": false
    },
    "box3": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector3"
        },
        "max": {
          "$ref": "#/$defs/vector3"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector2"
        },
        "max": {
          "$ref": "#/$defs/vector2"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "worldPreset": {
      "type": "object",
      "properties": {
        "clock": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "season": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
        },
        "weather": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "clear",
                "fewClouds",
                "cloudy",
                "overcast",
                "fog",
                "lightRain",
                "rain",
                "thunderstorm",
                "afterRain",
                "snow",
                "afterSnow"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "intensity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clock",
        "season"
      ],
      "additionalProperties": false
    },
    "slotId": {
      "type": "string",
      "pattern": "^(s[1-3]|m[1-9])$"
    },
    "teleport": {
      "type": "object",
      "properties": {
        "fly": {
          "$ref": "#/$defs/pose"
        },
        "stand": {
          "anyOf": [
            {
              "$ref": "#/$defs/stand"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "skylight",
                "door",
                "waterSurface"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fly"
      ],
      "additionalProperties": false
    },
    "marker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "anchor",
            "viewpoint",
            "interior",
            "route",
            "landmark",
            "facility",
            "custom",
            "quest"
          ]
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "at": {
          "$ref": "#/$defs/vector2"
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        },
        "minZoomBand": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "teleport": {
          "anyOf": [
            {
              "$ref": "#/$defs/teleport"
            },
            {
              "type": "null"
            }
          ]
        },
        "feature": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "waypointId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "routeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "form": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "kiosk",
                "post"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "at",
        "icon",
        "priority",
        "minZoomBand"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "landmark",
                  "facility",
                  "custom",
                  "quest"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "teleport": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector2"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/vector2"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "priority"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            {
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "at"
              ],
              "properties": {
                "at": {
                  "$ref": "#/$defs/vector2"
                }
              }
            },
            {
              "required": [
                "line"
              ],
              "properties": {
                "line": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/vector2"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "markersFile": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "atlasRect": {
          "$ref": "#/$defs/rect"
        },
        "zoomMin": {
          "type": "number",
          "minimum": 0
        },
        "zoomMax": {
          "type": "number",
          "minimum": 0
        },
        "zoomBands": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "hidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "version",
        "atlasRect",
        "markers"
      ],
      "additionalProperties": false
    },
    "labelsFile": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        }
      },
      "required": [
        "version",
        "labels",
        "regions",
        "places"
      ],
      "additionalProperties": false
    }
  }
}
