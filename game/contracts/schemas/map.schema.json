{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "Authored map descriptor v1",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/mapId"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "kind": {
      "type": "string",
      "enum": [
        "outdoor",
        "interior",
        "instance"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "dataRect": {
      "$ref": "#/$defs/rect"
    },
    "roam": {
      "type": "object",
      "properties": {
        "heightFactor": {
          "type": "number",
          "minimum": 0
        },
        "heightStart": {
          "type": "number",
          "minimum": 0
        },
        "maxRadius": {
          "type": "number",
          "minimum": 0
        },
        "buffer": {
          "type": "number",
          "minimum": 0
        },
        "softFloorClearance": {
          "type": "number",
          "minimum": 0
        },
        "fallbackMargin": {
          "type": "number",
          "minimum": 0
        },
        "pushRate": {
          "type": "number",
          "minimum": 0
        },
        "pushMax": {
          "type": "number",
          "minimum": 0
        },
        "edgeFogMax": {
          "type": "number",
          "minimum": 0
        },
        "floorY": {
          "type": "number"
        },
        "ceilY": {
          "type": "number"
        }
      },
      "required": [
        "heightFactor",
        "heightStart",
        "maxRadius",
        "floorY",
        "ceilY",
        "buffer",
        "softFloorClearance",
        "fallbackMargin"
      ],
      "additionalProperties": false
    },
    "terrainDefaults": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lakeBankSlope": {
              "type": "string",
              "pattern": "^1:(?!0+(?:\\.0+)?$)[0-9]+(?:\\.[0-9]+)?(?![\\s\\S])"
            },
            "lakeMaxDepth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3.4028234663852886e+38
            },
            "channelBankSlope": {
              "type": "string",
              "pattern": "^1:(?!0+(?:\\.0+)?$)[0-9]+(?:\\.[0-9]+)?(?![\\s\\S])"
            },
            "channelDepth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3.4028234663852886e+38
            },
            "corridorShoulder": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3.4028234663852886e+38
            }
          },
          "required": [
            "lakeBankSlope",
            "lakeMaxDepth",
            "channelBankSlope",
            "channelDepth",
            "corridorShoulder"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "defaultSpawn": {
      "type": "string",
      "minLength": 1
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fly": {
            "$ref": "#/$defs/pose"
          },
          "stand": {
            "anyOf": [
              {
                "$ref": "#/$defs/stand"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "fly"
        ],
        "additionalProperties": false
      }
    },
    "world": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "enum": [
            "shared",
            "fixed"
          ]
        },
        "default": {
          "$ref": "#/$defs/worldPreset"
        },
        "defaultName": {
          "$ref": "#/$defs/name"
        },
        "quietUntilDusk": {
          "type": "boolean"
        },
        "weatherProfile": {
          "type": "string",
          "minLength": 1
        },
        "sunProfile": {
          "type": "string",
          "minLength": 1
        },
        "fixed": {
          "anyOf": [
            {
              "$ref": "#/$defs/worldPreset"
            },
            {
              "type": "null"
            }
          ]
        },
        "newGameStart": {
          "anyOf": [
            {
              "$ref": "#/$defs/worldPreset"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "time",
        "default",
        "defaultName",
        "quietUntilDusk",
        "weatherProfile"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "time": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "fixed": {
                "$ref": "#/$defs/worldPreset"
              }
            },
            "required": [
              "fixed"
            ]
          }
        }
      ]
    },
    "env": {
      "type": "object",
      "properties": {
        "sky": {
          "type": "string",
          "minLength": 1
        },
        "backdrop": {
          "type": "string",
          "minLength": 1
        },
        "reflectLakes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outskirts": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sky",
        "backdrop",
        "reflectLakes"
      ],
      "additionalProperties": false
    },
    "title": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "t0": {
              "$ref": "#/$defs/pose"
            },
            "cloudLayout": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "t0",
            "cloudLayout"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "cinematics": {
      "type": "object",
      "properties": {
        "enterNew": {
          "type": "string",
          "minLength": 1
        },
        "enterNewShort": {
          "type": "string",
          "minLength": 1
        },
        "enterContinue": {
          "type": "string",
          "minLength": 1
        },
        "leave": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "$ref": "#/$defs/box3"
          },
          "target": {
            "$ref": "#/$defs/mapId"
          },
          "targetSpawn": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "trigger",
          "target",
          "targetSpawn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "version",
    "seed",
    "dataRect",
    "roam",
    "defaultSpawn",
    "spawns",
    "world",
    "env",
    "cinematics",
    "portals"
  ],
  "additionalProperties": false,
  "$defs": {
    "mapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "vector2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "name": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "yawDeg": {
          "type": "number"
        },
        "pitchDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fovDeg": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "position",
        "yawDeg",
        "pitchDeg"
      ],
      "additionalProperties": false
    },
    "stand": {
      "type": "object",
      "properties": {
        "feet": {
          "$ref": "#/$defs/vector3"
        },
        "yawDeg": {
          "type": "number"
        }
      },
      "required": [
        "feet",
        "yawDeg"
      ],
      "additionalProperties": false
    },
    "box3": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector3"
        },
        "max": {
          "$ref": "#/$defs/vector3"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector2"
        },
        "max": {
          "$ref": "#/$defs/vector2"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "worldPreset": {
      "type": "object",
      "properties": {
        "clock": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "season": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
        },
        "weather": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "clear",
                "fewClouds",
                "cloudy",
                "overcast",
                "fog",
                "lightRain",
                "rain",
                "thunderstorm",
                "afterRain",
                "snow",
                "afterSnow"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "intensity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clock",
        "season"
      ],
      "additionalProperties": false
    },
    "slotId": {
      "type": "string",
      "pattern": "^(s[1-3]|m[1-9])$"
    }
  }
}
