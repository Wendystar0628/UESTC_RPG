<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup><LangVersion>14.0</LangVersion><RootNamespace>Campus</RootNamespace><EnableDynamicLoading>true</EnableDynamicLoading><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="gdUnit4.api" PrivateAssets="all" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Remove="contracts/**/*.cs;gen/**/*.cs;testing/**/*.cs;**/tests/**/*.cs" />
    <ProjectReference Include="contracts/Campus.Contracts.csproj;contracts/Runtime/Campus.Contracts.Runtime.csproj;gen/Campus.Gen.csproj;gen/maps/*/*.csproj" />
    <AdditionalFiles Include="../scripts/gates/arch/BannedSymbols.Common.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="gdunit4_testadapter_v*/**/*.cs" />
  </ItemGroup>
  <Target Name="EnsureGdUnitTestRunner" BeforeTargets="CoreCompile"
          Condition="'$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true' And '@(PackageReference-&gt;WithMetadataValue('Identity', 'gdUnit4.api'))' != ''">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/setup/install-test-runner.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)/..&quot;" />
    <PropertyGroup>
      <_CampusGdUnitRunnerSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'gdunit4_testadapter_v5/GdUnit4TestRunnerScene.cs'))</_CampusGdUnitRunnerSource>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.FullPath)' == '$(_CampusGdUnitRunnerSource)'" />
      <Compile Include="gdunit4_testadapter_v5/GdUnit4TestRunnerScene.cs" Condition="Exists('gdunit4_testadapter_v5/GdUnit4TestRunnerScene.cs')" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateStyleShaders" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="python -X utf8 &quot;$(MSBuildProjectDirectory)/../scripts/build/generate-style-shaders.py&quot; --root &quot;$(MSBuildProjectDirectory)/..&quot;" />
    <ItemGroup>
      <FileWrites Include="$(MSBuildProjectDirectory)/style/shaders/style_consts.gdshaderinc;$(MSBuildProjectDirectory)/style/outline/fog.glslinc" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateBuildInformation" BeforeTargets="CoreCompile">
    <Exec Condition="'$(DesignTimeBuild)' != 'true'" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/build/build-info.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)/..&quot; -Output &quot;$(IntermediateOutputPath)BuildInfo.g.cs&quot; -Configuration &quot;$(Configuration)&quot; -ModuleAssemblies &quot;$(TargetName);@(_ResolvedProjectReferencePaths-&gt;'%(Filename)', ';')&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" /></ItemGroup>
  </Target>
  <PropertyGroup>
    <_CampusCodeFingerprintTool>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '../scripts/build/fingerprints/Campus.CodeFingerprints.csproj'))</_CampusCodeFingerprintTool>
    <_CampusCodeFingerprintManifest>$(MSBuildProjectDirectory)/data/build-code-fingerprints.json</_CampusCodeFingerprintManifest>
    <_CampusCodeFingerprintToolBuildTarget>Build</_CampusCodeFingerprintToolBuildTarget>
    <_CampusLaunchBuildProperties>Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)</_CampusLaunchBuildProperties>
  </PropertyGroup>
  <Target Name="RestoreCampusCodeFingerprintTool">
    <MSBuild Projects="$(_CampusCodeFingerprintTool)" Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" BuildInParallel="false" />
  </Target>
  <!-- SDK Rebuild is BeforeRebuild -> Clean -> Build -> AfterRebuild.
       Begin before Clean; a timestamp-incremental Build alone cannot verify new bytes. -->
  <Target Name="BeginCampusLaunchRebuildReceipt" BeforeTargets="BeforeRebuild"
          DependsOnTargets="RestoreCampusCodeFingerprintTool" Condition="'$(DesignTimeBuild)' != 'true' And '$(Configuration)' == 'Debug' And '$(RuntimeIdentifier)' == '' And '$(SelfContained)' != 'true' And '$(TargetPath)' == '$(MSBuildProjectDirectory)\.godot\mono\temp\bin\Debug\Campus.dll'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/lib/start-game.ps1&quot; -BuildReceiptPhase BeginRebuild -BuildReceiptRoot &quot;$(MSBuildProjectDirectory)/..&quot; -BuildReceiptProperties &quot;$(_CampusLaunchBuildProperties);TargetPath=$(TargetPath)&quot;" />
    <PropertyGroup>
      <_CampusLaunchBuildReceiptStarted>true</_CampusLaunchBuildReceiptStarted>
      <_CampusLaunchRebuild>true</_CampusLaunchRebuild>
      <_CampusCodeFingerprintToolBuildTarget>Rebuild</_CampusCodeFingerprintToolBuildTarget>
    </PropertyGroup>
  </Target>
  <Target Name="BeginCampusLaunchBuildReceipt" BeforeTargets="BeforeBuild"
          DependsOnTargets="RestoreCampusCodeFingerprintTool" Condition="'$(DesignTimeBuild)' != 'true' And '$(_CampusLaunchBuildReceiptStarted)' != 'true' And '$(Configuration)' == 'Debug' And '$(RuntimeIdentifier)' == '' And '$(SelfContained)' != 'true' And '$(TargetPath)' == '$(MSBuildProjectDirectory)\.godot\mono\temp\bin\Debug\Campus.dll'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/lib/start-game.ps1&quot; -BuildReceiptPhase Begin -BuildReceiptRoot &quot;$(MSBuildProjectDirectory)/..&quot; -BuildReceiptProperties &quot;$(_CampusLaunchBuildProperties);TargetPath=$(TargetPath)&quot;" />
    <PropertyGroup><_CampusLaunchBuildReceiptStarted>true</_CampusLaunchBuildReceiptStarted></PropertyGroup>
  </Target>
  <Target Name="PrepareCampusCodeFingerprints" DependsOnTargets="GetCampusCodeFingerprintInputs;RestoreCampusCodeFingerprintTool">
    <!-- Build the host tool inside this Build invocation; it is not a game module. -->
    <MSBuild Projects="$(_CampusCodeFingerprintTool)" Targets="$(_CampusCodeFingerprintToolBuildTarget);GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CampusCodeFingerprintToolOutput" />
    </MSBuild>
    <MSBuild Projects="$(_CampusCodeFingerprintTool)" Targets="GetCampusCodeFingerprintInputs"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CampusCodeFingerprintInput" />
    </MSBuild>
    <PropertyGroup>
      <_CampusCodeFingerprintStamp>$(IntermediateOutputPath)CodeFingerprints.succeeded</_CampusCodeFingerprintStamp>
    </PropertyGroup>
    <ItemGroup>
      <_CampusCodeFingerprintToolPath Include="@(_CampusCodeFingerprintToolOutput)" />
      <_CampusCodeFingerprintInput Include="$(MSBuildProjectDirectory)/../global.json;$(MSBuildProjectDirectory)/../docs/ROUTES.json" />
      <_CampusCodeFingerprintProperty Include="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)" />
      <_CampusCodeFingerprintProperty Include="RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != ''" />
      <_CampusCodeFingerprintProperty Include="SelfContained=$(SelfContained)" Condition="'$(SelfContained)' != ''" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_CampusCodeFingerprintToolPath)">
      <Output TaskParameter="Filtered" ItemName="_CampusCodeFingerprintToolTargetPath" />
    </RemoveDuplicates>
    <!-- The JSON may retain its timestamp when its contents are unchanged. -->
    <Delete Files="$(_CampusCodeFingerprintStamp)" Condition="!Exists('$(_CampusCodeFingerprintManifest)')" />
  </Target>
  <Target Name="GenerateCampusCodeFingerprints" AfterTargets="Build"
          DependsOnTargets="PrepareCampusCodeFingerprints"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(IsTestProject)' != 'true'"
          Inputs="@(_CampusCodeFingerprintInput);$(_CampusCodeFingerprintManifest)"
          Outputs="$(_CampusCodeFingerprintStamp)">
    <Exec Command="dotnet &quot;@(_CampusCodeFingerprintToolTargetPath)&quot; --project &quot;$(MSBuildProjectFullPath)&quot; --tool-project &quot;$(_CampusCodeFingerprintTool)&quot; --output &quot;$(_CampusCodeFingerprintManifest)&quot; @(_CampusCodeFingerprintProperty-&gt;'--property &quot;%(Identity)&quot;', ' ')" />
    <Touch Files="$(_CampusCodeFingerprintStamp)" AlwaysCreate="true" />
    <ItemGroup><FileWrites Include="$(_CampusCodeFingerprintStamp)" /></ItemGroup>
  </Target>
  <Target Name="RecordCampusCodeFingerprintCompletion" AfterTargets="GenerateCampusCodeFingerprints"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(IsTestProject)' != 'true'">
    <PropertyGroup><_CampusLaunchFingerprintsCompleted>true</_CampusLaunchFingerprintsCompleted></PropertyGroup>
  </Target>
  <Target Name="CompleteCampusLaunchNormalBuildReceipt" AfterTargets="RecordCampusCodeFingerprintCompletion"
          DependsOnTargets="CompleteCampusLaunchBuildReceipt"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(_CampusLaunchRebuild)' != 'true'" />
  <Target Name="CompleteCampusLaunchRebuildReceipt" AfterTargets="AfterRebuild"
          DependsOnTargets="CompleteCampusLaunchBuildReceipt"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(_CampusLaunchRebuild)' == 'true'" />
  <Target Name="CompleteCampusLaunchBuildReceipt"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(_CampusLaunchBuildReceiptStarted)' == 'true' And '$(_CampusLaunchFingerprintsCompleted)' == 'true' And '$(Configuration)' == 'Debug' And '$(RuntimeIdentifier)' == '' And '$(SelfContained)' != 'true' And '$(TargetPath)' == '$(MSBuildProjectDirectory)\.godot\mono\temp\bin\Debug\Campus.dll'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/lib/start-game.ps1&quot; -BuildReceiptPhase Complete -BuildReceiptRoot &quot;$(MSBuildProjectDirectory)/..&quot; -BuildReceiptProperties &quot;$(_CampusLaunchBuildProperties);TargetPath=$(TargetPath)&quot;" />
  </Target>
</Project>
