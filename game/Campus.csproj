<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup><LangVersion>14.0</LangVersion><RootNamespace>Campus</RootNamespace><EnableDynamicLoading>true</EnableDynamicLoading><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="gdUnit4.api" PrivateAssets="all" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Remove="contracts/**/*.cs;gen/**/*.cs;testing/**/*.cs;**/tests/**/*.cs" />
    <ProjectReference Include="contracts/Campus.Contracts.csproj;contracts/Runtime/Campus.Contracts.Runtime.csproj;gen/Campus.Gen.csproj;gen/maps/*/*.csproj" />
    <!-- Let the normal restore/build graph prepare the existing tool without referencing its assembly. -->
    <ProjectReference Include="../scripts/build/fingerprints/Campus.CodeFingerprints.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="_CampusCodeFingerprintToolTargetPath"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;TargetPath" />
    <AdditionalFiles Include="../scripts/gates/arch/BannedSymbols.Common.txt" />
    <CampusGeneratedCompile Include="BuildInfo.g.cs" Generator="BuildInformation" OutputDirectoryProperty="IntermediateOutputPath" />
    <CampusGeneratedCompile Include="gdunit4_testadapter_v5/GdUnit4TestRunnerScene.cs" Generator="TestRunner" Condition="'$(Configuration)' == 'Debug'" />
    <CampusGeneratedFile Include="style/shaders/style_consts.gdshaderinc;style/outline/fog.glslinc" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="gdunit4_testadapter_v*/**/*.cs" />
  </ItemGroup>
  <PropertyGroup>
    <_CampusGdUnitApiPackage>@(PackageReference-&gt;WithMetadataValue('Identity', 'gdUnit4.api'))</_CampusGdUnitApiPackage>
    <_CampusGdUnitRunnerSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'gdunit4_testadapter_v5/GdUnit4TestRunnerScene.cs'))</_CampusGdUnitRunnerSource>
    <_CampusCodeFingerprintTool>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '../scripts/build/fingerprints/Campus.CodeFingerprints.csproj'))</_CampusCodeFingerprintTool>
    <_CampusPublishedCodeFingerprintManifest>$(MSBuildProjectDirectory)/data/build-code-fingerprints.json</_CampusPublishedCodeFingerprintManifest>
    <_CampusBuildCommitFile>$(MSBuildProjectDirectory)/data/build-commit.txt</_CampusBuildCommitFile>
  </PropertyGroup>
  <Target Name="PrepareCampusGeneratedFiles" BeforeTargets="PrepareForBuild;CoreClean">
    <PropertyGroup>
      <_CampusGdUnitRunnerStamp>$(IntermediateOutputPath)gdunit-test-runner.stamp</_CampusGdUnitRunnerStamp>
      <_CampusStyleShaderStamp>$(IntermediateOutputPath)style-shaders.stamp</_CampusStyleShaderStamp>
      <_CampusBuildInformationSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'BuildInfo.g.cs'))</_CampusBuildInformationSource>
      <_CampusBuildInformationStamp>$(IntermediateOutputPath)build-information.stamp</_CampusBuildInformationStamp>
      <_CampusCodeFingerprintManifest>$(IntermediateOutputPath)build-code-fingerprints.json</_CampusCodeFingerprintManifest>
      <_CampusCodeFingerprintStamp>$(IntermediateOutputPath)code-fingerprints.stamp</_CampusCodeFingerprintStamp>
    </PropertyGroup>
    <ItemGroup>
      <!-- Conservative native globs track source changes; Python alone owns the shader bindings. -->
      <_CampusStyleShaderInput Include="**/*.cs;style/**/*.json;style/**/*.gdshaderinc;../scripts/build/generate-style-shaders.py"
                               Exclude="$(DefaultItemExcludes);@(CampusGeneratedCompile);@(CampusGeneratedFile)" />
      <FileWrites Include="$(_CampusGdUnitRunnerStamp);$(_CampusGdUnitRunnerSource);$(_CampusStyleShaderStamp);@(CampusGeneratedFile-&gt;'%(FullPath)');$(_CampusBuildInformationStamp);$(_CampusBuildInformationSource);$(_CampusCodeFingerprintStamp);$(_CampusCodeFingerprintManifest);$(_CampusBuildCommitFile);$(_CampusPublishedCodeFingerprintManifest)" />
      <!-- CoreClean's native Clean items include generated products outside obj/bin. -->
      <Clean Include="$(_CampusGdUnitRunnerStamp);$(_CampusGdUnitRunnerSource);$(_CampusStyleShaderStamp);@(CampusGeneratedFile-&gt;'%(FullPath)');$(_CampusBuildInformationStamp);$(_CampusBuildInformationSource);$(_CampusCodeFingerprintStamp);$(_CampusCodeFingerprintManifest);$(_CampusBuildCommitFile);$(_CampusPublishedCodeFingerprintManifest)" />
    </ItemGroup>
    <!-- A missing real product invalidates its completion stamp before native incremental checks. -->
    <Delete Files="$(_CampusGdUnitRunnerStamp)" Condition="!Exists('$(_CampusGdUnitRunnerSource)')" />
    <Delete Files="$(_CampusStyleShaderStamp)" Condition="!Exists('%(CampusGeneratedFile.Identity)')" />
    <Delete Files="$(_CampusBuildInformationStamp)" Condition="!Exists('$(_CampusBuildInformationSource)')" />
    <Delete Files="$(_CampusCodeFingerprintStamp)" Condition="!Exists('$(_CampusCodeFingerprintManifest)')" />
  </Target>
  <Target Name="EnsureGdUnitTestRunner"
          DependsOnTargets="PrepareCampusGeneratedFiles"
          Condition="'$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true' And '$(_CampusGdUnitApiPackage)' != ''"
          Inputs="$(MSBuildAllProjects);$(ProjectAssetsFile);$(MSBuildProjectDirectory)/../scripts/setup/install-test-runner.ps1"
          Outputs="$(_CampusGdUnitRunnerStamp)">
    <Delete Files="$(_CampusGdUnitRunnerStamp)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/setup/install-test-runner.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)/..&quot;" />
    <Error Condition="!Exists('$(_CampusGdUnitRunnerSource)')" Text="The test runner generator did not produce $(_CampusGdUnitRunnerSource)." />
    <Touch Files="$(_CampusGdUnitRunnerStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="IncludeGdUnitTestRunner" BeforeTargets="CoreCompile" DependsOnTargets="EnsureGdUnitTestRunner"
          Condition="'$(Configuration)' == 'Debug' And '$(_CampusGdUnitApiPackage)' != ''">
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.FullPath)' == '$(_CampusGdUnitRunnerSource)'" />
      <Compile Include="$(_CampusGdUnitRunnerSource)" Condition="Exists('$(_CampusGdUnitRunnerSource)')" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateStyleShaders" BeforeTargets="PrepareForBuild" DependsOnTargets="PrepareCampusGeneratedFiles"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildAllProjects);@(_CampusStyleShaderInput)" Outputs="$(_CampusStyleShaderStamp)">
    <Delete Files="$(_CampusStyleShaderStamp)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="python -X utf8 &quot;$(MSBuildProjectDirectory)/../scripts/build/generate-style-shaders.py&quot; --root &quot;$(MSBuildProjectDirectory)/..&quot;" />
    <Error Condition="!Exists('%(CampusGeneratedFile.Identity)')" Text="The shader generator did not produce %(CampusGeneratedFile.Identity)." />
    <Touch Files="$(_CampusStyleShaderStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="PrepareCampusBuildInformation" DependsOnTargets="PrepareCampusGeneratedFiles;ResolveReferences">
    <ItemGroup>
      <_CampusBuildInformationInput Include="$(MSBuildAllProjects);$(ProjectAssetsFile);@(ProjectReference-&gt;'%(FullPath)');@(_ResolvedProjectReferencePaths-&gt;'%(FullPath)');../version.txt" />
      <_CampusBuildInformationExistingInput Include="@(_CampusBuildInformationInput)" Condition="Exists('%(_CampusBuildInformationInput.Identity)')" />
      <_CampusBuildInformationExistingInput Remove="$(_CampusBuildInformationSource)" />
      <Compile Include="$(_CampusBuildInformationSource)" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeCampusBuildInformation" BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareCampusBuildInformation;GenerateBuildInformation;UpdateCampusBuildCommit" />
  <Target Name="GenerateBuildInformation" DependsOnTargets="PrepareCampusBuildInformation"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_CampusBuildInformationExistingInput)" Outputs="$(_CampusBuildInformationStamp)">
    <Delete Files="$(_CampusBuildInformationStamp)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ReadLinesFromFile File="../version.txt">
      <Output TaskParameter="Lines" ItemName="_CampusBuildVersionLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_CampusBuildModule Include="$(TargetName);@(_ResolvedProjectReferencePaths-&gt;'%(Filename)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_CampusBuildModule)">
      <Output TaskParameter="Filtered" ItemName="_CampusBuildModuleDistinct" />
    </RemoveDuplicates>
    <PropertyGroup>
      <_CampusBuildVersion>@(_CampusBuildVersionLine)</_CampusBuildVersion>
      <_CampusBuildKind>export</_CampusBuildKind>
      <_CampusBuildKind Condition="'$(Configuration)' == 'Debug'">dev</_CampusBuildKind>
      <_CampusBuildInformationContent>// &lt;auto-generated /&gt;
namespace Campus.Kernel.Registry%3B
internal static class BuildInfo {
 public const string Version = "$(_CampusBuildVersion.Trim())"%3B
 public static string Commit =&gt; Godot.FileAccess.GetFileAsString("res://data/build-commit.txt").Trim()%3B
 public static string Build =&gt; Version + "+" + Commit%3B
 public const string Kind = "$(_CampusBuildKind)"%3B
 public static readonly string[] ModuleAssemblies = [@(_CampusBuildModuleDistinct-&gt;'&quot;%(Identity)&quot;', ',')]%3B
}
</_CampusBuildInformationContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CampusBuildInformationSource)" Lines="$(_CampusBuildInformationContent)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Touch Files="$(_CampusBuildInformationStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="UpdateCampusBuildCommit" DependsOnTargets="PrepareCampusBuildInformation"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/build/build-info.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)/..&quot;" />
  </Target>
  <!-- Preserve the real invocation configuration for Roslyn; run this only when the manifest is stale. -->
  <UsingTask TaskName="CampusBuildGlobalProperties" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Defaults ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Properties ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var property in ((IBuildEngine6)BuildEngine).GetGlobalProperties()) values.Add(property.Key, property.Value);
        foreach (var item in Defaults)
        {
            var equals = item.ItemSpec.IndexOf('=');
            if (equals <= 0) throw new InvalidOperationException("A build configuration property has no name.");
            var name = item.ItemSpec.Substring(0, equals);
            if (!values.ContainsKey(name)) values.Add(name, item.ItemSpec.Substring(equals + 1));
        }
        Properties = values.OrderBy(pair => pair.Key, StringComparer.Ordinal)
            .Select(pair => (ITaskItem)new TaskItem(Convert.ToBase64String(Encoding.UTF8.GetBytes(pair.Key + "=" + pair.Value)))).ToArray();
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PrepareCampusCodeFingerprints" DependsOnTargets="PrepareCampusGeneratedFiles;GetCampusCodeFingerprintSources">
    <ItemGroup>
      <_CampusBuildDefaultProperty Include="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)" />
      <_CampusBuildDefaultProperty Include="RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != ''" />
      <_CampusBuildDefaultProperty Include="SelfContained=$(SelfContained)" Condition="'$(SelfContained)' != ''" />
      <!-- The root's CoreCompile can add generated sources/configs after its precompile input collection. -->
      <_CampusNativeFingerprintInput Include="@(Compile-&gt;'%(FullPath)');@(EditorConfigFiles-&gt;'%(FullPath)');@(Analyzer-&gt;'%(FullPath)');@(AdditionalFiles-&gt;'%(FullPath)')" />
      <!-- Build information is excluded from CPU hashes; remove it after recursive and late Compile collection. -->
      <_CampusNativeFingerprintInput Remove="$(_CampusBuildInformationSource)" />
      <_CampusFingerprintExistingInput Include="@(_CampusNativeFingerprintInput)" Condition="Exists('%(_CampusNativeFingerprintInput.Identity)')" />
      <_CampusFingerprintExistingInput Include="../global.json;../Directory.Build.props;../Directory.Build.targets;../Directory.Packages.props;../docs/ROUTES.json" />
      <_CampusFingerprintExistingInput Include="../NuGet.Config" Condition="Exists('../NuGet.Config')" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateCampusCodeFingerprints" DependsOnTargets="PrepareCampusCodeFingerprints"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_CampusFingerprintExistingInput)" Outputs="$(_CampusCodeFingerprintStamp)">
    <Delete Files="$(_CampusCodeFingerprintStamp)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <CampusBuildGlobalProperties Defaults="@(_CampusBuildDefaultProperty)">
      <Output TaskParameter="Properties" ItemName="_CampusCodeFingerprintProperty" />
    </CampusBuildGlobalProperties>
    <Exec Command="dotnet &quot;@(_CampusCodeFingerprintToolTargetPath)&quot; --project &quot;$(MSBuildProjectFullPath)&quot; --tool-project &quot;$(_CampusCodeFingerprintTool)&quot; --output &quot;$(_CampusCodeFingerprintManifest)&quot; @(_CampusCodeFingerprintProperty-&gt;'--encoded-property &quot;%(Identity)&quot;', ' ') @(_CampusBuildDefaultProperty-&gt;'--configuration-property &quot;%(Identity)&quot;', ' ')"
          LogStandardErrorAsError="true" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
    <Error Condition="!Exists('$(_CampusCodeFingerprintManifest)')" Text="The code fingerprint generator did not produce $(_CampusCodeFingerprintManifest)." />
    <Touch Files="$(_CampusCodeFingerprintStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="PublishCampusCodeFingerprints" AfterTargets="Build" DependsOnTargets="GenerateCampusCodeFingerprints"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(IsTestProject)' != 'true'">
    <Copy SourceFiles="$(_CampusCodeFingerprintManifest)" DestinationFiles="$(_CampusPublishedCodeFingerprintManifest)" SkipUnchangedFiles="true" />
  </Target>
</Project>
