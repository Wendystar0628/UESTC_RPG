; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="电光年华"
run/main_scene="res://stage/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="UESTC"
config/project_settings_override="user://engine_override.cfg"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/hud/app_icon_placeholder.svg"

[audio]

driver/mix_rate=48000

[autoload]

Boot="*res://kernel/boot/Boot.cs"
Kernel="*res://kernel/registry/Kernel.cs"

[campus]

maps/index="res://data/maps/index.json"
rulesets/default="res://data/rulesets/sightseeing.json"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Campus"

[gui]

common/show_focus_state_on_pointer_event=0

