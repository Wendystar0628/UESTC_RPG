<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><LangVersion>14.0</LangVersion><TargetFramework>net10.0</TargetFramework><RootNamespace>Campus.Gen.Tests</RootNamespace><EnableDefaultCompileItems>false</EnableDefaultCompileItems><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup><Compile Include="testing/Support/**/*.cs;contracts/**/tests/**/*.cs;gen/**/tests/**/*.cs;../pipeline/map/tests/**/*.cs" /><Compile Remove="contracts/Runtime/**/tests/**/*.cs" /><ProjectReference Include="contracts/Campus.Contracts.csproj;contracts/Runtime/Campus.Contracts.Runtime.csproj;gen/Campus.Gen.csproj;gen/maps/*/*.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="gdUnit4.api" />
    <PackageReference Include="gdUnit4.test.adapter" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="GodotSharp" />
  </ItemGroup>
  <Target Name="RequireDebugTestHost" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)' != 'Debug'" Text="Campus.Gen.Tests uses the Debug test configuration. Use -c Debug; release export is checked separately by G6." />
  </Target>
</Project>
