{
  "schema": 1,
  "authority": "ENG-PERF-DATA",
  "draft": false,
  "encoding": {
    "text": "UTF-8 without BOM",
    "csv": "RFC4180",
    "newLine": "LF",
    "decimal": "invariant",
    "missingCsv": "null",
    "missingJson": null,
    "booleanCsv": [
      "true",
      "false"
    ],
    "nonFinite": "null",
    "integers": "base10; retain uint64 precision",
    "nestedCsv": "compact JSON with RFC4180 quoting"
  },
  "clock": {
    "monotonicSource": "Godot.Time.GetTicksUsec",
    "monotonicUnit": "ms",
    "monotonicOrigin": "process boot, shared with GAME-218",
    "anchorIntervalSeconds": 60,
    "wallClockPurpose": [
      "sessionId",
      "startedAt",
      "clockAnchors"
    ],
    "driverTimestamps": "raw wall-clock microseconds; never pretend exact frame alignment"
  },
  "contextFlags": [
    {
      "name": "mapTransition",
      "value": 1,
      "source": "AppActivity"
    },
    {
      "name": "cameraTransition",
      "value": 2,
      "source": "AppActivity"
    },
    {
      "name": "saveWrite",
      "value": 4,
      "source": "AppActivity"
    },
    {
      "name": "seasonTransition",
      "value": 8,
      "source": "AppActivity"
    },
    {
      "name": "notPlaying",
      "value": 16,
      "source": "AppState"
    },
    {
      "name": "loadingVisible",
      "value": 32,
      "source": "GAME-221"
    },
    {
      "name": "qualityApplying",
      "value": 64,
      "source": "GAME-221"
    },
    {
      "name": "windowUnfocused",
      "value": 128,
      "source": "GAME-229"
    },
    {
      "name": "inputLocked",
      "value": 256,
      "source": "input owner"
    },
    {
      "name": "captureFrame",
      "value": 512,
      "source": "capture owner"
    },
    {
      "name": "qualitySettling",
      "value": 1024,
      "source": "GAME-221 dictionary rules"
    },
    {
      "name": "newGameOrLoad",
      "value": 2048,
      "source": "app/save owner"
    }
  ],
  "nonSteadyRules": {
    "owner": "GAME-221",
    "unknownContext": "unknown; do not classify as steady",
    "appStates": [
      "title",
      "entering",
      "leaving"
    ],
    "rules": [
      {
        "name": "transition",
        "events": [
          "world.clockJump",
          "world.season",
          "transit",
          "map.travel",
          "view.mode"
        ],
        "interval": "owner begin to actual completion",
        "settleMs": 2000
      },
      {
        "name": "newGameOrLoad",
        "events": [
          "game.enter",
          "save.load"
        ],
        "interval": "begin to actual ready",
        "settleMs": 2000
      },
      {
        "name": "qualityApply",
        "events": [
          "settings.quality"
        ],
        "interval": "apply begin to actual effective completion",
        "settleMs": 2000
      },
      {
        "name": "saveThumbnail",
        "events": [
          "sync.readback"
        ],
        "purpose": "saveThumbnail",
        "interval": "the captured collection frame only",
        "settleMs": 0
      }
    ],
    "notAutomaticallyNonSteady": [
      "weather slow transition",
      "save write without thumbnail",
      "focus loss",
      "menu/input lock"
    ],
    "thresholdAuthority": "settleMs only here; no duplicate runtime or analyzer literals"
  },
  "objects": {
    "viewportSample": [
      {
        "name": "viewportId",
        "type": "integer",
        "nullable": false,
        "unit": null,
        "source": "ViewportFrameSample.ViewportId",
        "note": ""
      },
      {
        "name": "role",
        "type": "string",
        "nullable": false,
        "unit": null,
        "source": "ViewportFrameSample.Role stable registration",
        "note": ""
      },
      {
        "name": "drewThisFrame",
        "type": "boolean",
        "nullable": true,
        "unit": null,
        "source": "owner draw report",
        "note": "False is an explicit current-row skip; true requests alone do not prove actual drawing, so remain null"
      },
      {
        "name": "resultUpdated",
        "type": "boolean",
        "nullable": true,
        "unit": null,
        "source": "proven readback freshness",
        "note": "Main approximate costs do not confirm freshness; keep null without independent evidence"
      },
      {
        "name": "sourceDrawFrame",
        "type": "integer",
        "nullable": true,
        "unit": null,
        "source": "proven render round source",
        "note": "Unknown for main approximate costs; never infer by subtracting a fixed frame offset"
      },
      {
        "name": "sourceCpuBeginUs",
        "type": "integer",
        "nullable": true,
        "unit": "us",
        "source": "raw timestamp CPU begin",
        "note": ""
      },
      {
        "name": "sourceCpuEndUs",
        "type": "integer",
        "nullable": true,
        "unit": "us",
        "source": "raw timestamp CPU end",
        "note": ""
      },
      {
        "name": "cpuRenderMs",
        "type": "number",
        "nullable": true,
        "unit": "ms",
        "source": "RenderingServer.ViewportGetMeasuredRenderTimeCpu for main; proven readback otherwise",
        "alignment": "Main: approximate +/-2 frames (DECISION-342); on-demand: proven source only",
        "provenance": "Main may carry a cost with null resultUpdated/sourceDrawFrame; no timestamp-name reads",
        "note": "Wall-clock span including waits/preemption; current-row skip or non-drawable window is null; unconfirmed on-demand result is null"
      },
      {
        "name": "gpuRenderMs",
        "type": "number",
        "nullable": true,
        "unit": "ms",
        "source": "RenderingServer.ViewportGetMeasuredRenderTimeGpu for main; proven readback otherwise",
        "alignment": "Same as viewportSample.cpuRenderMs",
        "provenance": "Same as viewportSample.cpuRenderMs; an approximate cost does not establish mergeable GPU timing",
        "note": "Distributions/budgets/trends allowed; no exact per-frame spike attribution"
      }
    ]
  },
