// fog.glslinc — GLSL mirror of game/style/shaders/fog.gdshaderinc (WP-04), for the WP-05 compute passes.
// Mirrors WP-04 commit 92c31b4 line for line (ART-SKYLIGHT §6.5): any change to fog.gdshaderinc is copied here,
// and the sandbox parity test (same inputs, same fog amount and colour) is re-run.
//
// Compute shaders cannot read global shader parameters. The includer therefore declares, BEFORE including this
// file, the same names the material side reads, filled each frame by C# from the same state that writes the
// globals (ENG-PERF §1.5) — usually as macros onto its uniform buffer:
//   fog, fog_low, weather_fog, map_rect, medium (vec4), medium_color (vec4, linear rgb), key_dir (vec3),
//   veil, edge_fog (float), and `sampler2D palette` bound to the palette's RD texture through its sRGB view
//   (RenderingServer.TextureGetRdTexture(rid, true)), so texelFetch returns linear values like the
//   source_color global does on the material side.
//
// Signatures (same as fog.gdshaderinc):
//   vec4 fog_eval(vec3 world_pos, vec3 cam_pos)
//   vec4 fog_eval_biased(vec3 world_pos, vec3 cam_pos, float exempt)   exempt 0..1 (per-instance fog_exempt on the
//                                                                     material side; compute passes have no instance and use 0)
//   vec3 fog_desaturate(vec3 c, float dist)
//   float fog_equiv_dist(vec3 world_pos, vec3 cam_pos)   height-integrated fog distance (also the fog_desaturate dist)
//   vec3 fog_sky(vec3 dir_w)

#ifndef FOG_GLSLINC
#define FOG_GLSLINC

// ---------------------------------------------------------------------------
// Palette (ART-STYLE §8.5, ENG-PERF §1.5): 256x64 RGBA8, sRGB bytes, read with texelFetch.
// Row 0 current colours, row 1 lamp-lit, row 2 interior shade, row 3 interior lit, rows 4-63 seasonal.
// ---------------------------------------------------------------------------
const int PAL_ROW_CUR = 0;
const int PAL_ROW_LAMP = 1;
const int PAL_ROW_IN_SHADE = 2;
const int PAL_ROW_IN_LIT = 3;
const int PAL_ROW_SEASON0 = 4;

const int PAL_SHADE_OFFSET = 1;

// Column numbers of the single colour names in row 0, identical to fog.gdshaderinc and game/style/palette/core.json
// (per-frame names 0-31, retired 32-39, weather and emissive constants 40-63, surface pairs from 64). Generated
// from the registry later.
const int PAL_SUN_LIGHT = 0;
const int PAL_AMBIENT_SKY = 1;
const int PAL_BOUNCE_GROUND = 2;
const int PAL_INTERIOR_WARM = 3;
const int PAL_LINE_WARM = 4;
const int PAL_LINE_COOL = 5;
const int PAL_SHAFT_NEAR = 6;
const int PAL_SHAFT_FAR = 7;
const int PAL_RIM = 8;
const int PAL_GLASS_GLARE = 9;
const int PAL_WINDOW_WARM = 10;
const int PAL_WINDOW_COOL = 11;
const int PAL_SHADOW_1 = 12;
const int PAL_FOG_SUN = 13;
const int PAL_FOG_ANTI = 14;
const int PAL_SKY_SUN0 = 15;
const int PAL_SKY_ANTI0 = 20;
const int PAL_SKY_CLOUD_LIT = 25;
const int PAL_SKY_CLOUD_RIM = 26;
const int PAL_SKY_CLOUD_BELLY = 27;
const int PAL_SKY_CLOUD_DEEP = 28;
const int PAL_SKY_MOON = 29;
// 30-31 spare; 32-39 reserved for retired colour names, never referenced.
const int PAL_WEATHER_OVERCAST = 40;
const int PAL_WEATHER_SNOW_OVERCAST = 41;
const int PAL_WEATHER_NIGHT_RAIN = 42;
const int PAL_WEATHER_CB_BASE = 43;
const int PAL_WEATHER_FOG = 44;
const int PAL_WEATHER_WASHED_SKY = 45;
const int PAL_SIGN_GREEN = 48;
const int PAL_FIREFLY = 49;
const int PAL_WATER_POOL_GLOW = 50;
const int PAL_LAMP_WARM = 51;
const int PAL_LAMP_AMBER = 52;
const int PAL_LAMP_COOL = 53;

// The sRGB texture view decodes on fetch (see header), matching the material side's source_color.
const bool PAL_MANUAL_SRGB = false;

vec3 toon_srgb_decode(vec3 c) {
	vec3 lo = c / 12.92;
	vec3 hi = pow((c + 0.055) / 1.055, vec3(2.4));
	return mix(lo, hi, step(vec3(0.04045), c));
}

vec3 pal_fetch(int col, int row) {
	vec3 c = texelFetch(palette, ivec2(clamp(col, 0, 255), clamp(row, 0, 63)), 0).rgb;
	return PAL_MANUAL_SRGB ? toon_srgb_decode(c) : c;
}

vec3 pal_cur(int col) {
	return pal_fetch(col, PAL_ROW_CUR);
}

vec3 pal_season(int row, float s) {
	float x = fract(s * 0.25) * 256.0 - 0.5;
	float x0 = floor(x);
	float f = x - x0;
	int i0 = int(mod(x0, 256.0));
	int i1 = int(mod(x0 + 1.0, 256.0));
	return mix(pal_fetch(i0, row), pal_fetch(i1, row), f);
}

const float FOG_SIL_ALPHA = 0.9;
const float FOG_RATE = 2.3;
const float FOG_DESAT = 0.25;
const float FOG_VEIL_GAIN = 0.8;
const float FOG_VEIL_NEAR = 20.0;
const float FOG_EDGE_GAIN = 0.6;
const float FOG_WEATHER_SIL_MIN = 600.0;
const float FOG_SCALE_HEIGHT = 200.0;

const float FOG_SKY_E1 = 0.07;
const float FOG_SKY_E2 = 0.20;
const float FOG_SKY_E3 = 0.45;

float fog_weather_mult() {
	return weather_fog.x > 0.0 ? weather_fog.x : 1.0;
}

float fog_key_side(vec3 dir_w) {
	vec2 k = key_dir.xz;
	vec2 v = dir_w.xz;
	float lk = length(k);
	float lv = length(v);
	if (lk < 1e-4 || lv < 1e-4) {
		return 0.5;
	}
	return smoothstep(-0.35, 1.0, dot(v / lv, k / lk));
}

vec3 fog_sky_column(int base, float e) {
	e = clamp(e, 0.0, 1.0);
	vec3 c = pal_cur(base);
	c = mix(c, pal_cur(base + 1), clamp(e / FOG_SKY_E1, 0.0, 1.0));
	c = mix(c, pal_cur(base + 2), clamp((e - FOG_SKY_E1) / (FOG_SKY_E2 - FOG_SKY_E1), 0.0, 1.0));
	c = mix(c, pal_cur(base + 3), clamp((e - FOG_SKY_E2) / (FOG_SKY_E3 - FOG_SKY_E2), 0.0, 1.0));
	c = mix(c, pal_cur(base + 4), clamp((e - FOG_SKY_E3) / (1.0 - FOG_SKY_E3), 0.0, 1.0));
	return c;
}

vec3 fog_sky(vec3 dir_w) {
	vec3 d = normalize(dir_w);
	float w = fog_key_side(d);
	return mix(fog_sky_column(PAL_SKY_ANTI0, d.y), fog_sky_column(PAL_SKY_SUN0, d.y), w);
}

const float FOG_EXEMPT_START = 200.0;
const float FOG_EXEMPT_SIL = 800.0;

vec2 fog_range(float exempt) {
	float m = fog_weather_mult();
	float start = fog.z / m;
	float sil = max(fog.w / m, min(fog.w, FOG_WEATHER_SIL_MIN));
	float k = clamp(exempt, 0.0, 1.0);
	sil = mix(sil, max(sil, FOG_EXEMPT_SIL), k);
	start = mix(start, max(start, FOG_EXEMPT_START), k);
	// Veil (ART-SKYLIGHT §6.4): start and silhouette distances close in from far to near; the 2D veil layer only
	// completes the cover at the end. Applied last, so landmark exemption does not resist the veil.
	float v = clamp(veil, 0.0, 1.0);
	sil = (sil - FOG_VEIL_NEAR) * (1.0 - v) * (1.0 - v) + FOG_VEIL_NEAR;
	start = min(start * (1.0 - v), sil * 0.5);
	return vec2(start, max(sil, start + 1.0));
}

// Equivalent fog distance: the view ray integrated over exp(-y / scale height), expressed as a ground-level
// horizontal distance. Level views are unchanged; looking down from height the fog path gets shorter.
float fog_equiv_dist(vec3 world_pos, vec3 cam_pos) {
	float dist = length(world_pos - cam_pos);
	float lo = max(min(world_pos.y, cam_pos.y), 0.0);
	float hi = max(max(world_pos.y, cam_pos.y), 0.0);
	float dy = hi - lo;
	float e_lo = exp(-lo / FOG_SCALE_HEIGHT);
	float avg = dy < 1.0 ? e_lo : FOG_SCALE_HEIGHT * (e_lo - exp(-hi / FOG_SCALE_HEIGHT)) / dy;
	return dist * avg;
}

vec3 fog_desaturate(vec3 c, float dist) {
	float start = fog_range(0.0).x;
	float k = FOG_DESAT * smoothstep(start, start * 2.0, dist);
	float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	return mix(c, vec3(l), k);
}

vec4 fog_eval_biased(vec3 world_pos, vec3 cam_pos, float exempt) {
	vec3 ray = world_pos - cam_pos;
	float dist = length(ray);
	vec3 dir = dist > 1e-4 ? ray / dist : vec3(0.0, 0.0, -1.0);
	vec2 rg = fog_range(exempt);

	float dens = max(fog.x, 0.0) * (1.0 + FOG_VEIL_GAIN * clamp(veil, 0.0, 1.0));
	vec2 ctr = map_rect.xy + 0.5 / max(map_rect.zw, vec2(1e-6));
	vec2 outward = cam_pos.xz - ctr;
	float lo = length(outward);
	vec2 dir_h = dir.xz;
	float lh = length(dir_h);
	if (lo > 1e-3 && lh > 1e-3 && edge_fog > 0.0) {
		float w = smoothstep(0.0, 0.5, dot(dir_h / lh, outward / lo));
		dens *= 1.0 + FOG_EDGE_GAIN * edge_fog * w;
	}

	float t = max(fog_equiv_dist(world_pos, cam_pos) - rg.x, 0.0) / (rg.y - rg.x);
	// Under the veil the cap and the haze band open up, so at veil = 1 the 3D fog sinks everything by itself.
	float vv = clamp(veil, 0.0, 1.0);
	float a = mix(FOG_SIL_ALPHA, 1.0, vv) * (1.0 - exp(-FOG_RATE * t * dens));

	float h_avg = max(0.5 * (cam_pos.y + world_pos.y), 0.0);
	a *= mix(mix(0.55, 1.0, exp(-h_avg / max(fog.y, 1.0))), 1.0, vv);

	float g_top = max(max(fog_low.x, weather_fog.y), 0.1);
	float g_dens = 1.0 - (1.0 - clamp(fog_low.y, 0.0, 1.0)) * (1.0 - clamp(weather_fog.z, 0.0, 1.0));
	float a_g = g_dens * (1.0 - smoothstep(0.0, g_top, world_pos.y)) * (1.0 - exp(-dist / 40.0));
	a = 1.0 - (1.0 - a) * (1.0 - a_g);

	vec3 col = mix(pal_cur(PAL_FOG_ANTI), pal_cur(PAL_FOG_SUN), fog_key_side(dir));

	vec4 res = vec4(col, clamp(a, 0.0, 1.0));
	if (medium.z > 0.0) {
		float a_m = 1.0 - exp(-dist / max(medium.w, 0.5));
		res = mix(res, vec4(medium_color.rgb, a_m), clamp(medium.z, 0.0, 1.0));
	}
	return res;
}

vec4 fog_eval(vec3 world_pos, vec3 cam_pos) {
	return fog_eval_biased(world_pos, cam_pos, 0.0);
}

#endif
